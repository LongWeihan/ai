<div class="col mb-4">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card hoverable project-card-horizontal">
      <div class="row no-gutters">
        {% if project.img %}
          <div class="col-4 col-md-3 project-thumb-col">
            {% include figure.liquid loading="eager" path=project.img sizes="(min-width: 992px) 220px, (min-width: 768px) 200px, 35vw" alt="project thumbnail" class="project-thumb-img" %}
          </div>
        {% endif %}
        <div class="{% if project.img %}col-8 col-md-9{% else %}col-12{% endif %}">
          <div class="card-body">
            <h3 class="card-title project-card-title" title="{{ project.title }}">{{ project.title }}</h3>
            <p class="card-text">{{ project.description }}</p>
            <div class="row ml-1 mr-1 p-0">
              {% if project.github %}
                <div class="github-icon">
                  <div class="icon" data-toggle="tooltip" title="Code Repository">
                    <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
                  </div>
                  {% if project.github_stars %}
                    <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                      <i class="fa-solid fa-star"></i>
                      <span id="{{ project.github_stars }}-stars"></span>
                    </span>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </a>
</div>
